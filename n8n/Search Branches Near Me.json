      "id": "b24c217f-cf39-4d2a-b401-a5e2b65ab6f9",
      "name": "Places Search Error Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2272, -48]
