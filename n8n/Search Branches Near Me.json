    {
      "parameters": {
        "jsCode": "const webhookBody = $('Webhook').first().json.body || {};\nconst geocodeBody = $input.first().json.body || $input.first().json;\n\nconst center = geocodeBody.results[0].geometry.location;\nconst lenderDisplayName = (webhookBody.lenderDisplayName || \"\").trim();\n\n// Use strict query with bank name quotes or custom search query to avoid general category match\nconst query = webhookBody.placesSearchQuery || (lenderDisplayName ? `\"${lenderDisplayName}\"` : \"bank branch\");\nconst radiusMiles = Number(webhookBody.radiusMiles) || 25;\nconst radiusMeters = Math.round(radiusMiles * 1609.34);\nconst limit = typeof webhookBody.limit === 'number' ? webhookBody.limit : (Number(webhookBody.limit) || 5);\n\nreturn [{\n  json: {\n    center,\n    query,\n    radiusMeters,\n    limit,\n    zip: webhookBody.zip,\n    lenderDisplayName\n  }\n}];"
      },
