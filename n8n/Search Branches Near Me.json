        "responseBody": "={\n  \"error\": \"PlacesApiError\",\n  \"message\": {{ $json.statusCode !== 200 ? '\"Text Search HTTP ' + $json.statusCode + '\"' : '\"Places Search status ' + $json.body.status + '\"' }}\n}",
        "options": {
