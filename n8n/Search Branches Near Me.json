      "parameters": {
        "jsCode": "const item = $input.first();\n\n// 1. Check if json object is empty OR if addressPostal is missing\nconst isJsonEmpty = !item.json || Object.keys(item.json).length === 0;\n\nif (isJsonEmpty || !item.json.addressPostal) {\n  return [];\n}\n\nconst zip = item.json.addressPostal\nconst apiKey = $('Config').first().json.GOOGLE_PLACES_API_KEY\n\nconst url = `https://maps.googleapis.com/maps/api/geocode/json?address=${encodeURIComponent(zip)}&components=country:US&key=${apiKey}`\n\n// 2. Return postal address when JSON is valid and present\nreturn [\n  {\n    json: {\n      url\n    }\n  }\n];\n"
      },
