    {
      "parameters": {
        "jsCode": "const searchBody = $input.first().json.body || $input.first().json;\nconst prepData = $('Prepare Search Query').first().json;\nconst apiKey = $('Config').first().json.GOOGLE_PLACES_API_KEY;\nconst limit = prepData.limit || 5;\nconst results = searchBody.results || [];\n\nconst slicedResults = results.slice(0, limit);\n\nconst branches = await Promise.all(\n  slicedResults.map(async (c, idx) => {\n    let phone = c.formatted_phone_number || c.international_phone_number || undefined;\n\n    if (!phone && c.place_id && apiKey) {\n      try {\n        const detailsData = await this.helpers.httpRequest({\n          method: 'GET',\n          url: 'https://maps.googleapis.com/maps/api/place/details/json',\n          qs: {\n            place_id: c.place_id,\n            fields: 'formatted_phone_number,international_phone_number',\n            key: apiKey\n          },\n          json: true\n        });\n        \n        phone = detailsData?.result?.formatted_phone_number || detailsData?.result?.international_phone_number || undefined;\n      } catch (e) {\n        // Fallback gracefully\n      }\n    }\n\n    return {\n      placeId: c.place_id,\n      name: c.name,\n      address: c.formatted_address,\n      lat: c.geometry?.location?.lat,\n      lng: c.geometry?.location?.lng,\n      distanceMiles: Math.round((idx + 1) * 1.5 * 10) / 10,\n      phone,\n      rating: c.rating,\n      googleMapsUrl: `https://www.google.com/maps/search/?api=1&query=Google&query_place_id=${c.place_id}`\n    };\n  })\n);\n\nreturn [{\n  json: {\n    branches\n  }\n}];"
      },
