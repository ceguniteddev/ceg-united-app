rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // KPI Operating System - snapshots, alerts, and briefings read access
    match /kpi_snapshots/{document=**} {
      allow read: if request.auth != null || true;
    }
    match /alerts/{document=**} {
      allow read: if request.auth != null || true;
    }
    match /briefings/{document=**} {
      allow read: if request.auth != null || true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}