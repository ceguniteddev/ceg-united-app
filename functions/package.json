  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/genai": "^1.52.0",
    "@hubspot/api-client": "^14.0.1",
    "@lob/lob-typescript-sdk": "^1.2.1",
    "asana": "^3.1.12",
    "busboy": "^1.6.0",
    "express": "^5.2.1",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "google-ads-api": "^24.1.0",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^7.1.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^22.0.0"
  },
  "devDependencies": {
