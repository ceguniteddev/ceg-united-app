{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy:staging": "firebase deploy --only functions --project cegunitedllc",
    "deploy:production": "firebase deploy --only functions --project ceg-united-llc-prod",
