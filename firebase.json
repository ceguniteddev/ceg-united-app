{
  "firestore": [
    {
      "database": "ceg-united-db-staging",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "ceg-united-db-production",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "firebase-commands-prod": "firebase deploy --only firestore:ceg-united-db-production --project ceg-united-llc-prod",
  "firebase-commands-staging": "firebase deploy --only firestore:ceg-united-db-staging --project cegunitedllc",
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ]
}
